<?xml version="1.0" encoding="utf-8"?>
<!--
  Один OfficeChat.exe, которому не нужен установленный .NET.
  Сборка:  dotnet publish -p:PublishProfile=SingleExe
  Результат: bin\publish\OfficeChat.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Нативные библиотеки (SQLite, WPF) тоже внутри exe — распаковываются при запуске -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
</Project>
