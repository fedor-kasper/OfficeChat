<Window x:Class="OfficeChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat"
        Width="820" Height="540" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель: я + список компьютеров в сети -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Изменить" Padding="8,2"
                            VerticalAlignment="Center" Click="ChangeName_Click" />
                    <StackPanel>
                        <TextBlock Text="Вы" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="MyNameText" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" x:Name="OnlineCountText" Margin="14,10,14,4"
                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

            <ListBox x:Name="ContactsList" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ContactsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="6,6">
                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0"
                                     VerticalAlignment="Center" Fill="{StaticResource OnlineBrush}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая часть: переписка (появится на следующем этапе) -->
        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                <TextBlock x:Name="ChatTitleText" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Выберите, кому написать" />
                <TextBlock x:Name="ChatHintText" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Слева — компьютеры, на которых сейчас запущен OfficeChat." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
