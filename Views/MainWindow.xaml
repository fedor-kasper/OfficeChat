<Window x:Class="OfficeChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OfficeChat.Views"
        Title="OfficeChat"
        Width="960" Height="600" MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <local:ImageThumbnailConverter x:Key="Thumbnail" DecodeWidth="640" />

        <!-- Пузырёк сообщения: входящие слева серые, исходящие справа синие, ждущие в очереди — жёлтые -->
        <DataTemplate x:Key="MessageTemplate">
            <Border x:Name="Bubble" MaxWidth="460" Margin="0,3" Padding="10,6,10,5" CornerRadius="10"
                    HorizontalAlignment="Left" Background="#EEF0F3">
                <StackPanel>
                    <TextBlock Text="сообщение всем" FontSize="10" Margin="0,0,0,2"
                               Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding IsBroadcast, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Изображение: превью в ленте, клик — просмотр, правый клик — сохранить/копировать -->
                    <Border Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                            Margin="-6,-2,-6,4" CornerRadius="8" Background="#11000000" Cursor="Hand"
                            HorizontalAlignment="Left" ToolTip="{Binding FileName}"
                            MouseLeftButtonUp="Image_Click">
                        <Grid>
                            <Image Source="{Binding ImagePath, Converter={StaticResource Thumbnail}}"
                                   MaxWidth="320" MaxHeight="320" Stretch="Uniform" StretchDirection="DownOnly"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть" FontWeight="SemiBold" Click="ImageOpen_Click" />
                                <MenuItem Header="Сохранить как…" Click="ImageSave_Click" />
                                <MenuItem Header="Копировать" Click="ImageCopy_Click" />
                                <MenuItem Header="Открыть в программе просмотра" Click="ImageOpenExternal_Click" />
                            </ContextMenu>
                        </Border.ContextMenu>
                    </Border>
                    <!-- Файл: значок по типу, имя, размер и действия -->
                    <Border Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,4" Padding="10,8" CornerRadius="8" Background="#0F000000" MinWidth="250">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding FileIcon}" FontSize="30"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                <TextBlock Text="{Binding FileSizeText}" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Открыть" Padding="10,2" FontSize="12" Click="FileOpen_Click" />
                                    <Button Content="Сохранить как…" Padding="10,2" FontSize="12" Margin="6,0,0,0"
                                            Click="FileSave_Click" />
                                    <Button Content="Показать в папке" Padding="10,2" FontSize="12" Margin="6,0,0,0"
                                            Click="FileShowInFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             FontSize="14" BorderThickness="0" Background="Transparent" Padding="0"
                             Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel Margin="0,3,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="10" Margin="10,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </DockPanel>
                    <Button Content="Отменить отправку" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Padding="8,1" FontSize="11" Click="CancelMessage_Click"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="#DCE8FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanCancel}" Value="True">
                    <Setter TargetName="Bubble" Property="Background" Value="#FFF1D6" />
                </DataTrigger>
                <!-- Итог мини-игры: по центру, отдельным цветом -->
                <DataTrigger Binding="{Binding IsGame}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="Bubble" Property="Background" Value="#F3E8FF" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#D8B4FE" />
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель: я + список компьютеров -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Настройки" Padding="8,2"
                            VerticalAlignment="Center" Click="Settings_Click" />
                    <StackPanel>
                        <TextBlock Text="Вы" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="MyNameText" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Брандмауэр не пропускает входящие: к нам не смогут подключиться -->
            <Border x:Name="FirewallBanner" DockPanel.Dock="Bottom" Margin="10" Padding="10,8" CornerRadius="8"
                    Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#78350F"
                               Text="⚠ Брандмауэр Windows не пропускает входящие подключения к OfficeChat — вам не смогут написать или прислать изображение." />
                    <Button x:Name="FirewallButton" Content="Разрешить" Margin="0,8,0,0" Padding="12,4"
                            HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Background="#D97706"
                            ToolTip="Добавит правило брандмауэра для всех типов сети. Windows попросит права администратора."
                            Click="AllowFirewall_Click" />
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" x:Name="OnlineCountText" Margin="14,10,14,4"
                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

            <ListBox x:Name="ContactsList" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ContactsList_SelectionChanged"
                     ContextMenuOpening="ContactsList_ContextMenuOpening">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="6,6">
                            <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0"
                                     VerticalAlignment="Center" Fill="{StaticResource OnlineBrush}" />
                            <Border DockPanel.Dock="Right" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0"
                                    VerticalAlignment="Center" Background="{StaticResource AccentBrush}"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="#C4C8CF" />
                                <Setter TargetName="TitleText" Property="Foreground"
                                        Value="{StaticResource MutedTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEveryone}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая часть: заглушка, пока никто не выбран -->
        <StackPanel x:Name="EmptyPanel" Grid.Column="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
            <TextBlock FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Text="Выберите, кому написать" />
            <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Слева — компьютеры, на которых запущен OfficeChat. Чтобы написать всем сразу, выберите «Все»." />
        </StackPanel>

        <!-- Правая часть: переписка -->
        <DockPanel x:Name="ChatPanel" Grid.Column="1" Visibility="Collapsed" AllowDrop="True"
                   PreviewDragEnter="ChatPanel_PreviewDragOver" PreviewDragOver="ChatPanel_PreviewDragOver"
                   PreviewDragLeave="ChatPanel_PreviewDragLeave" PreviewDrop="ChatPanel_PreviewDrop">
            <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding Peer, Converter={StaticResource NotNullToVisibility}}">
                        <Button Content="🎮 Крестики-нолики" Padding="8,2" Margin="0,0,6,0"
                                ToolTip="Пригласить собеседника сыграть" Click="InviteToGame_Click"
                                Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Очистить переписку" Padding="8,2" Click="ClearConversation_Click" />
                        <Button Content="Удалить из списка" Padding="8,2" Margin="6,0,0,0"
                                Click="RemoveContact_Click"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ChatTitleText" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ChatStatusText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="12,8,12,12" BorderBrush="#E2E5EA" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="NoticeText" DockPanel.Dock="Top" Margin="2,0,0,6" FontSize="11"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                               Visibility="Collapsed" />

                    <!-- Изображения, выбранные для отправки: уйдут по «Отправить», текст станет подписью -->
                    <ScrollViewer x:Name="AttachmentsBar" DockPanel.Dock="Top" Margin="0,0,0,8"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="AttachmentsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="84" Height="84" Margin="0,0,8,0" ToolTip="{Binding FileName}">
                                        <Border CornerRadius="8" Background="#F3F5F8" BorderBrush="#E2E5EA"
                                                BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Margin="2"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- Файл: значок и имя -->
                                                <StackPanel Margin="4,6,4,16" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding FileName}" FontSize="10" TextAlignment="Center"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border VerticalAlignment="Bottom" Background="#99000000" CornerRadius="0,0,8,8">
                                            <TextBlock Text="{Binding SizeText}" Foreground="White" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,1" />
                                        </Border>
                                        <Button Content="✕" Width="20" Height="20" FontSize="10" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                Style="{StaticResource FlatButton}" Background="#CC111827"
                                                ToolTip="Убрать" Click="RemoveAttachment_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button DockPanel.Dock="Left" Content="📎" Width="36" Margin="0,0,6,0" FontSize="16"
                            ToolTip="Прикрепить файл или изображение (также можно перетащить файлы в окно или вставить Ctrl+V)"
                            Click="Attach_Click" />
                    <Button DockPanel.Dock="Right" Content="Отправить" Margin="8,0,0,0" Padding="14,0"
                            VerticalAlignment="Stretch" Click="Send_Click" />
                    <TextBox x:Name="InputBox" FontSize="14" Padding="6,5" MinHeight="34" MaxHeight="120"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="InputBox_PreviewKeyDown" />
                </DockPanel>
            </Border>

            <!-- Партия в крестики-нолики: справа от ленты, сдвигает её, пока идёт игра -->
            <local:GamePanel x:Name="GameView" DockPanel.Dock="Right" Visibility="Collapsed" />

            <Grid>
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="14,8">
                    <StackPanel>
                        <Button Content="Показать более ранние сообщения" HorizontalAlignment="Center"
                                Margin="0,4,0,8" Padding="10,2" Click="LoadOlder_Click"
                                Visibility="{Binding HasOlderMessages, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource MessageTemplate}" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="MessagesHintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="340" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />

                <!-- Подсказка при перетаскивании файлов в окно -->
                <Border x:Name="DropOverlay" Margin="12" CornerRadius="12" Background="#E6EFF6FF"
                        BorderBrush="#2563EB" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📎" FontSize="40" HorizontalAlignment="Center" />
                        <TextBlock Text="Отпустите, чтобы прикрепить файлы" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1E3A8A" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
