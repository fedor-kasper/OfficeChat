<Window x:Class="OfficeChat.Views.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — напоминание"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Opacity="0">
    <!-- Рамка и шапка — в цвет важности; внешний отступ оставляет место для тени -->
    <Border x:Name="Frame" Margin="12,8,12,8" CornerRadius="10" Background="White" BorderThickness="3">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <Border x:Name="Header" CornerRadius="8,8,0,0" Padding="12,8,6,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="⏰" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Padding="0"
                            FontSize="13" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent"
                            ToolTip="Закрыть" Click="Close_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#4B5563" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock x:Name="BodyText" Margin="14,10,14,0" FontSize="15" TextWrapping="Wrap" Foreground="#111827" />
            <StackPanel Orientation="Horizontal" Margin="14,12,14,12">
                <Button Content="✓ Готово" Padding="14,5" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0"
                        Style="{StaticResource FlatButton}" Background="#16A34A" Click="Done_Click" />
                <Button x:Name="SnoozeButton" Content="⏱ Отложить ▾" Padding="12,5" FontSize="13" Margin="0,0,6,0"
                        Click="Snooze_Click" />
                <Button Content="Доска" Padding="10,5" FontSize="13" Background="Transparent" BorderBrush="Transparent"
                        Foreground="#2563EB" ToolTip="Открыть доску напоминаний" Click="Open_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
