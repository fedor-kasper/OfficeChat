<Window x:Class="OfficeChat.Views.GameInviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — приглашение в игру"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Opacity="0">
    <!-- Внешний отступ оставляет место для тени -->
    <Border Margin="12,8,12,8" CornerRadius="12" Background="White"
            BorderBrush="#2563EB" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <Border Background="{StaticResource HeaderBrush}" CornerRadius="10,10,0,0" Padding="14,10,14,10">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="White"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SenderText" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="приглашение в игру" FontSize="11" Foreground="#DBEAFE" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock x:Name="InviteText" Margin="16,14,16,0" FontSize="15" TextWrapping="Wrap" Foreground="#111827" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14,16,14">
                <Button Content="Отклонить" Padding="16,6" FontSize="14" Margin="0,0,8,0"
                        Style="{StaticResource FlatButton}" Background="#E5E7EB" Foreground="#111827"
                        Click="Decline_Click" />
                <Button Content="Принять" Padding="20,6" FontSize="14" FontWeight="SemiBold"
                        Style="{StaticResource FlatButton}" Background="#16A34A"
                        Click="Accept_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
