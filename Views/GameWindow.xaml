<Window x:Class="OfficeChat.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Крестики-нолики"
        Width="360" SizeToContent="Height"
        ResizeMode="CanMinimize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Window.Resources>
        <!-- Клетка поля: плоская кнопка с подсветкой при наведении -->
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="FontSize" Value="48" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#F3F5F8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#DBEAFE" />
                                <Setter Property="Cursor" Value="Hand" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock x:Name="PlayersText" FontSize="13" HorizontalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="StatusText" Margin="0,4,0,10" FontSize="18" FontWeight="SemiBold"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

        <!-- Поле 3×3, кнопки создаются в коде -->
        <UniformGrid x:Name="Board" Rows="3" Columns="3" Width="300" Height="300" />

        <Button x:Name="ActionButton" Margin="0,14,0,0" Padding="16,6" FontSize="14"
                HorizontalAlignment="Center" Click="Action_Click" />
    </StackPanel>
</Window>
