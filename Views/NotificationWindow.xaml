<Window x:Class="OfficeChat.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — новое сообщение"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Opacity="0">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2563EB" Offset="0" />
            <GradientStop Color="#3B82F6" Offset="1" />
        </LinearGradientBrush>

        <!-- Плоская кнопка с цветным фоном (стандартная кнопка WPF игнорирует фон при наведении) -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Внешний отступ оставляет место для тени -->
    <Border Margin="12,8,12,8" CornerRadius="12" Background="White"
            BorderBrush="#2563EB" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <!-- Яркая шапка: аватар, имя, время, закрыть -->
            <Border Background="{StaticResource HeaderBrush}" CornerRadius="10,10,0,0" Padding="14,10,8,10"
                    Cursor="Hand" MouseLeftButtonUp="Open_Click" ToolTip="Открыть переписку">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="White"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarText" FontSize="19" FontWeight="Bold" Foreground="#2563EB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" FontSize="14"
                            VerticalAlignment="Top" Style="{StaticResource FlatButton}" Background="Transparent"
                            ToolTip="Закрыть" Click="Close_Click" />
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Margin="8,0,6,0" FontSize="12"
                               VerticalAlignment="Center" Foreground="#DBEAFE" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SenderText" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BroadcastText" Text="сообщение всем" FontSize="11"
                                   Foreground="#DBEAFE" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Текст сообщения -->
            <TextBlock x:Name="MessageText" Margin="16,12,16,0" FontSize="15" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" MaxHeight="120" Foreground="#111827"
                       Cursor="Hand" MouseLeftButtonUp="Open_Click" ToolTip="Открыть переписку" />

            <!-- Быстрый ответ -->
            <DockPanel Margin="16,12,16,14">
                <Button DockPanel.Dock="Right" Content="Ответить" Margin="8,0,0,0" Padding="16,0"
                        FontSize="14" FontWeight="SemiBold" Style="{StaticResource FlatButton}"
                        Click="Reply_Click" />
                <Grid>
                    <TextBox x:Name="ReplyBox" FontSize="14" Padding="6,6" MaxLength="4000"
                             BorderBrush="#93C5FD"
                             TextChanged="ReplyBox_TextChanged" PreviewKeyDown="ReplyBox_PreviewKeyDown" />
                    <TextBlock x:Name="ReplyPlaceholder" Text="Быстрый ответ…" Margin="10,0,0,0" FontSize="14"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
