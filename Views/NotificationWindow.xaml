<Window x:Class="OfficeChat.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — новое сообщение"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Opacity="0">
    <!-- Внешний отступ оставляет место для тени -->
    <Border Margin="10,6,10,6" CornerRadius="10" Background="White"
            BorderBrush="#D9DDE3" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <StackPanel Margin="12,8,8,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24" Padding="0"
                        Background="Transparent" BorderThickness="0" ToolTip="Закрыть"
                        Foreground="{StaticResource MutedTextBrush}" Click="Close_Click" />
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Margin="8,0,4,0" FontSize="11"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="SenderText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                           MouseLeftButtonUp="Open_Click" ToolTip="Открыть переписку" />
            </DockPanel>

            <StackPanel Margin="0,2,4,0" Cursor="Hand" Background="Transparent"
                        MouseLeftButtonUp="Open_Click" ToolTip="Открыть переписку">
                <TextBlock x:Name="BroadcastText" Text="сообщение всем" FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="72" />
            </StackPanel>

            <DockPanel Margin="0,10,4,0">
                <Button DockPanel.Dock="Right" Content="Ответить" Margin="6,0,0,0" Padding="10,0"
                        Click="Reply_Click" />
                <Grid>
                    <TextBox x:Name="ReplyBox" FontSize="13" Padding="4,3" MaxLength="4000"
                             TextChanged="ReplyBox_TextChanged" PreviewKeyDown="ReplyBox_PreviewKeyDown" />
                    <TextBlock x:Name="ReplyPlaceholder" Text="Быстрый ответ…" Margin="8,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
