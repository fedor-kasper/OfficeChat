<Window x:Class="OfficeChat.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OfficeChat.Views"
        Title="OfficeChat — новое сообщение"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Opacity="0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:ImageThumbnailConverter x:Key="Thumbnail" DecodeWidth="480" />

        <!-- Строка в ленте окна: входящие — слева, ваши ответы — справа со статусом -->
        <DataTemplate x:Key="PopupMessageTemplate">
            <Border x:Name="Bubble" Margin="0,3" Padding="10,6,10,5" CornerRadius="8" MaxWidth="340"
                    HorizontalAlignment="Left" Background="#EFF6FF">
                <StackPanel>
                    <TextBlock Text="сообщение всем" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding IsBroadcast, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Изображение — превью прямо в уведомлении -->
                    <Image Source="{Binding ImagePath, Converter={StaticResource Thumbnail}}"
                           MaxWidth="300" MaxHeight="180" Stretch="Uniform" StretchDirection="DownOnly"
                           HorizontalAlignment="Left" Margin="0,2,0,4"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding PreviewText}" FontSize="15" TextWrapping="Wrap" Foreground="#111827" />
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="10" Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="#DBEAFE" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <!-- Внешний отступ оставляет место для тени -->
    <Border Margin="12,8,12,8" CornerRadius="12" Background="White"
            BorderBrush="#2563EB" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <!-- Яркая шапка: аватар, имя, время, закрыть -->
            <Border Background="{StaticResource HeaderBrush}" CornerRadius="10,10,0,0" Padding="14,10,8,10"
                    Cursor="Hand" MouseLeftButtonUp="Open_Click" ToolTip="Открыть переписку">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="White"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarText" FontSize="19" FontWeight="Bold" Foreground="#2563EB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" FontSize="14"
                            VerticalAlignment="Top" Style="{StaticResource FlatButton}" Background="Transparent"
                            ToolTip="Закрыть" Click="Close_Click" />
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Margin="8,0,6,0" FontSize="12"
                               VerticalAlignment="Center" Foreground="#DBEAFE" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SenderText" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="новое сообщение" FontSize="11" Foreground="#DBEAFE" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Лента: все непросмотренные сообщения от этого человека и ваши ответы -->
            <ScrollViewer x:Name="MessagesScroll" Margin="12,10,12,0" MaxHeight="260"
                          VerticalScrollBarVisibility="Auto" Cursor="Hand"
                          MouseLeftButtonUp="Open_Click" ToolTip="Открыть переписку">
                <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource PopupMessageTemplate}" />
            </ScrollViewer>

            <!-- Быстрый ответ -->
            <DockPanel Margin="16,12,16,14">
                <Button DockPanel.Dock="Right" Content="Ответить" Margin="8,0,0,0" Padding="16,0"
                        FontSize="14" FontWeight="SemiBold" Style="{StaticResource FlatButton}"
                        Click="Reply_Click" />
                <Grid>
                    <TextBox x:Name="ReplyBox" FontSize="14" Padding="6,6" MaxLength="4000"
                             BorderBrush="#93C5FD"
                             TextChanged="ReplyBox_TextChanged" PreviewKeyDown="ReplyBox_PreviewKeyDown" />
                    <TextBlock x:Name="ReplyPlaceholder" Text="Быстрый ответ…" Margin="10,0,0,0" FontSize="14"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
