<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OfficeChat для Android: оболочка вокруг интерфейса OfficeChat.Mobile — экран (Activity), фоновая служба,
    которая держит связь с сервером, и уведомления. Собирается в GitHub Actions (нужен Android SDK).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OfficeChat.Android</RootNamespace>
    <AssemblyName>OfficeChat.Android</AssemblyName>
    <ApplicationId>ru.officechat.app</ApplicationId>
    <ApplicationTitle>OfficeChat</ApplicationTitle>
    <!-- Версия: ApplicationDisplayVersion — как у остальных программ, ApplicationVersion — растущий номер сборки -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Управляемый HTTP-клиент: проверка отпечатка сертификата сервера — как на компьютерах -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeChat.Mobile\OfficeChat.Mobile.csproj" />
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
  </ItemGroup>

</Project>
