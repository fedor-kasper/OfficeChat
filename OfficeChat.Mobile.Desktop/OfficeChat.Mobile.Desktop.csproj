<Project Sdk="Microsoft.NET.Sdk">

  <!-- Интерфейс телефона в окне на компьютере — для разработки и проверки без телефона. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OfficeChat.Mobile.Desktop</RootNamespace>
    <AssemblyName>officechat-mobile</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeChat.Mobile\OfficeChat.Mobile.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
  </ItemGroup>

</Project>
