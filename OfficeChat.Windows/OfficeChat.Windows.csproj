<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только для значка в трее (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Позволяет собирать проект не только на Windows (например, в CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyTitle>Office Chat</AssemblyTitle>
    <!-- Имя exe не меняем: по нему работает обновление по сети и ярлыки пользователей -->
    <AssemblyName>OfficeChat</AssemblyName>
    <RootNamespace>OfficeChat</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иначе типы WinForms (Application, MessageBox, ...) конфликтуют с WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeChat.Core\OfficeChat.Core.csproj" />
  </ItemGroup>

</Project>
