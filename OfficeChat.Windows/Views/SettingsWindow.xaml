<Window x:Class="OfficeChat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — настройки"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Как вас показывать коллегам?" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Это имя увидят другие компьютеры в списке. Его можно поменять позже." />
        <TextBox x:Name="NameBox" FontSize="14" Padding="6,4" MaxLength="40"
                 TextChanged="NameBox_TextChanged" />

        <CheckBox x:Name="AutoStartBox" Margin="0,16,0,0"
                  Content="Запускать вместе с Windows (сразу в трей)" />

        <TextBlock x:Name="VersionText" Margin="0,14,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="Сохранить" Width="100" Padding="0,4"
                    IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
