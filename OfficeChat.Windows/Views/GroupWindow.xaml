<Window x:Class="OfficeChat.Views.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — группа"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="Название" Margin="0,12,0,4" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox x:Name="NameBox" FontSize="14" Padding="6,4" MaxLength="60" TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="MembersLabel" Margin="0,14,0,4" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="6" MaxHeight="300">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PeopleList" Margin="10,6" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="HintText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Width="100" Padding="0,4" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
