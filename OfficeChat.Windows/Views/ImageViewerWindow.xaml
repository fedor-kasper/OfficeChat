<Window x:Class="OfficeChat.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изображение"
        Width="1000" Height="720" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#F0101418">
    <Window.Resources>
        <Style x:Key="ViewerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Нижняя панель: имя файла, размер и действия -->
        <Border DockPanel.Dock="Bottom" Background="#CC000000" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить как…" Style="{StaticResource ViewerButton}" Background="#2563EB"
                            Click="Save_Click" />
                    <Button Content="Копировать" Style="{StaticResource ViewerButton}" Click="Copy_Click" />
                    <Button Content="Открыть в программе" Style="{StaticResource ViewerButton}" Click="OpenExternal_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InfoText" Foreground="#9CA3AF" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Подпись под фото, если есть -->
        <TextBlock x:Name="CaptionText" DockPanel.Dock="Bottom" Margin="20,8" Foreground="White" FontSize="14"
                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

        <!-- Само изображение: вписывается в окно, маленькие не растягиваются -->
        <Image x:Name="Picture" Margin="16" Stretch="Uniform" StretchDirection="DownOnly"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </DockPanel>
</Window>
