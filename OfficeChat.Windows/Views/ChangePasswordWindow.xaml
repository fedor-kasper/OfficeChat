<Window x:Class="OfficeChat.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — смена пароля"
        Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=OldBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Текущий пароль" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
        <PasswordBox x:Name="OldBox" FontSize="14" Padding="6,4" />
        <TextBlock Text="Новый пароль" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4" />
        <PasswordBox x:Name="NewBox" FontSize="14" Padding="6,4" />
        <TextBlock Text="Новый пароль ещё раз" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4" />
        <PasswordBox x:Name="RepeatBox" FontSize="14" Padding="6,4" />
        <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сменить" Width="100" Padding="0,4" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
