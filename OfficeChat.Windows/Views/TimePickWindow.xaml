<Window x:Class="OfficeChat.Views.TimePickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfficeChat — отложить"
        Width="320" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=TimeBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Отложить до" FontSize="15" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <DatePicker x:Name="DateBox" Width="140" />
            <TextBox x:Name="TimeBox" Width="70" Margin="8,0,0,0" Padding="4,3" MaxLength="5"
                     VerticalContentAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отложить" Width="100" Padding="0,4" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
