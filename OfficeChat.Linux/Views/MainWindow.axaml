<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OfficeChat.Views"
        x:Class="OfficeChat.Views.MainWindow"
        Title="OfficeChat"
        Width="960" Height="620" MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Window.Resources>
        <local:ImageThumbnailConverter x:Key="Thumbnail" DecodeWidth="640" />
    </Window.Resources>

    <Window.Styles>
        <!-- Пузырёк: входящие слева серые, исходящие справа синие, ждущие в очереди — жёлтые, итог игры — по центру -->
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="#EEF0F3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.bubble.outgoing">
            <Setter Property="Background" Value="#DCE8FF" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Border.bubble.queued">
            <Setter Property="Background" Value="#FFF1D6" />
        </Style>
        <Style Selector="Border.bubble.game">
            <Setter Property="Background" Value="#F3E8FF" />
            <Setter Property="BorderBrush" Value="#D8B4FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Текст сообщения выделяется и копируется, но выглядит как обычный текст -->
        <Style Selector="SelectableTextBlock.message">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <!-- Без уведомлений: счётчик серый, не отвлекает -->
        <Style Selector="Border.unread">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.unread.muted">
            <Setter Property="Background" Value="#9CA3AF" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.subtitle.typing">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Цитата в ответе: полоска слева, автор и начало текста -->
        <Style Selector="Border.quote">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Background" Value="#0D000000" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260,*">

        <!-- Левая панель: я + список компьютеров -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Настройки" Padding="8,3" FontSize="12"
                            VerticalAlignment="Center" Click="Settings_Click" />
                    <StackPanel>
                        <TextBlock Text="Вы" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="MyNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" x:Name="OnlineCountText" Margin="14,10,14,4"
                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

            <ListBox x:Name="ContactsList" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ContactsList_SelectionChanged"
                     ContextRequested="ContactsList_ContextRequested">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Panel DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource OnlineBrush}" IsVisible="{Binding IsOnline}" />
                                <Ellipse Fill="#C4C8CF" IsVisible="{Binding !IsOnline}" />
                            </Panel>
                            <Border DockPanel.Dock="Right" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0"
                                    VerticalAlignment="Center"
                                    Classes="unread" Classes.muted="{Binding IsMuted}" IsVisible="{Binding HasUnread}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="🔕" FontSize="11" Margin="4,0,0,0"
                                               VerticalAlignment="Center" ToolTip.Tip="Уведомления выключены"
                                               IsVisible="{Binding IsMuted}" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Classes="subtitle"
                                           Classes.typing="{Binding IsTyping}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая часть: заглушка, пока никто не выбран -->
        <StackPanel x:Name="EmptyPanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="360" Spacing="8">
            <TextBlock FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Выберите, кому написать" />
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                       Text="Слева — компьютеры, на которых запущен OfficeChat. Чтобы написать всем сразу, выберите «Все»." />
        </StackPanel>

        <!-- Правая часть: переписка -->
        <DockPanel x:Name="ChatPanel" Grid.Column="1" IsVisible="False" DragDrop.AllowDrop="True">
            <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"
                                IsVisible="{Binding Peer, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button Content="🎮 Крестики-нолики" Padding="8,3" FontSize="12"
                                ToolTip.Tip="Пригласить собеседника сыграть" Click="InviteToGame_Click"
                                IsVisible="{Binding IsOnline}" />
                        <Button x:Name="MuteButton" Padding="6,3" FontSize="12" Click="ToggleMute_Click" />
                        <Button Content="Очистить переписку" Padding="8,3" FontSize="12" Click="ClearConversation_Click" />
                        <Button Content="Удалить из списка" Padding="8,3" FontSize="12" Click="RemoveContact_Click"
                                IsVisible="{Binding CanRemove}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ChatTitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ChatStatusText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="12,8,12,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="NoticeText" DockPanel.Dock="Top" Margin="2,0,0,6" FontSize="11"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" IsVisible="False" />

                    <!-- Ответ на сообщение или его редактирование: что именно, и как отменить -->
                    <Border x:Name="ComposeBar" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,5" IsVisible="False"
                            Background="#F1F5FB" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                            CornerRadius="4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Padding="7,1" FontSize="12" VerticalAlignment="Center"
                                    ToolTip.Tip="Отменить (Esc)" Click="CancelCompose_Click" />
                            <StackPanel>
                                <TextBlock x:Name="ComposeTitle" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="ComposeText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#374151" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Изображения, выбранные для отправки: уйдут по «Отправить», текст станет подписью -->
                    <ScrollViewer x:Name="AttachmentsBar" DockPanel.Dock="Top" Margin="0,0,0,8"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="False">
                        <ItemsControl x:Name="AttachmentsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Panel Width="84" Height="84" ToolTip.Tip="{Binding FileName}">
                                        <Border CornerRadius="8" Background="#F3F5F8" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" ClipToBounds="True">
                                            <Panel>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding IsImage}" />
                                                <!-- Файл: значок и имя -->
                                                <StackPanel Margin="4,6,4,16" IsVisible="{Binding IsFile}">
                                                    <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding FileName}" FontSize="10" TextAlignment="Center"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" />
                                                </StackPanel>
                                            </Panel>
                                        </Border>
                                        <Border VerticalAlignment="Bottom" Background="#99000000" CornerRadius="0,0,8,8">
                                            <TextBlock Text="{Binding SizeText}" Foreground="White" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,1" />
                                        </Border>
                                        <Button Content="✕" Width="22" Height="22" FontSize="10" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Classes="flat" Background="#CC111827" ToolTip.Tip="Убрать"
                                                Click="RemoveAttachment_Click" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button DockPanel.Dock="Left" Content="📎" Width="40" Margin="0,0,6,0" FontSize="16"
                            VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Прикрепить файл или изображение (также можно перетащить файлы в окно или вставить Ctrl+V)"
                            Click="Attach_Click" />
                    <Button DockPanel.Dock="Right" Content="Отправить" Margin="8,0,0,0" Padding="14,0"
                            VerticalAlignment="Stretch" VerticalContentAlignment="Center" Classes="flat" Click="Send_Click" />
                    <TextBox x:Name="InputBox" FontSize="14" MinHeight="36" MaxHeight="120"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                             Watermark="Сообщение… (Enter — отправить, Shift+Enter — новая строка)" />
                </DockPanel>
            </Border>

            <!-- Партия в крестики-нолики: справа от ленты, сдвигает её, пока идёт игра -->
            <local:GamePanel x:Name="GameView" DockPanel.Dock="Right" IsVisible="False" />

            <Panel>
                <!-- Отступы — у содержимого, а не у ScrollViewer: иначе «прокрутить до конца» не доходит до низа -->
                <ScrollViewer x:Name="MessagesScroll">
                    <StackPanel Margin="14,8">
                        <Button Content="Показать более ранние сообщения" HorizontalAlignment="Center"
                                Margin="0,4,0,8" Padding="10,3" FontSize="12" Click="LoadOlder_Click"
                                IsVisible="{Binding HasOlderMessages}" />
                        <ItemsControl x:Name="MessagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="bubble" Classes.outgoing="{Binding IsOutgoing}"
                                            Classes.queued="{Binding CanCancel}" Classes.game="{Binding IsGame}"
                                            MaxWidth="460" Margin="0,3" Padding="10,6,10,5" CornerRadius="10">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Ответить" Click="ReplyMessage_Click" IsVisible="{Binding CanReply}" />
                                                <MenuItem Header="Изменить" Click="EditMessage_Click" IsVisible="{Binding CanEdit}" />
                                                <MenuItem Header="Копировать текст" Click="CopyMessage_Click" IsVisible="{Binding HasText}" />
                                                <Separator />
                                                <MenuItem Header="Удалить у себя" Click="DeleteForMe_Click" />
                                                <MenuItem Header="Удалить у всех" Click="DeleteForAll_Click"
                                                          IsVisible="{Binding CanDeleteForEveryone}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <TextBlock Text="сообщение всем" FontSize="10" Margin="0,0,0,2"
                                                       Foreground="{StaticResource MutedTextBrush}" IsVisible="{Binding IsBroadcast}" />

                                            <!-- Цитата: на какое сообщение это ответ; клик — показать оригинал -->
                                            <Border Classes="quote" IsVisible="{Binding HasReply}" ToolTip.Tip="Показать сообщение"
                                                    PointerReleased="Quote_PointerReleased">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ReplyAuthor}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="{Binding ReplyText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="#374151" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Изображение: клик — просмотр, правый клик — сохранить/копировать -->
                                            <Border IsVisible="{Binding IsImage}" Margin="-6,-2,-6,4" CornerRadius="8"
                                                    ClipToBounds="True" Cursor="Hand" HorizontalAlignment="Left"
                                                    ToolTip.Tip="{Binding FileName}" PointerReleased="Image_PointerReleased">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource Thumbnail}}"
                                                       MaxWidth="320" MaxHeight="320" Stretch="Uniform" StretchDirection="DownOnly" />
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Открыть" FontWeight="SemiBold" Click="ImageOpen_Click" />
                                                        <MenuItem Header="Сохранить как…" Click="ImageSave_Click" />
                                                        <MenuItem Header="Копировать" Click="ImageCopy_Click" />
                                                        <MenuItem Header="Открыть в программе просмотра" Click="ImageOpenExternal_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Ответить" Click="ReplyMessage_Click" />
                                                        <MenuItem Header="Изменить подпись" Click="EditMessage_Click" IsVisible="{Binding CanEdit}" />
                                                        <MenuItem Header="Удалить у себя" Click="DeleteForMe_Click" />
                                                        <MenuItem Header="Удалить у всех" Click="DeleteForAll_Click"
                                                                  IsVisible="{Binding CanDeleteForEveryone}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            </Border>

                                            <!-- Файл: значок по типу, имя, размер и действия -->
                                            <Border IsVisible="{Binding IsFile}" Margin="0,0,0,4" Padding="10,8"
                                                    CornerRadius="8" Background="#0F000000" MinWidth="250">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding FileIcon}" FontSize="30"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                                                   MaxWidth="320" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding FileName}" />
                                                        <TextBlock Text="{Binding FileSizeText}" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="6">
                                                            <Button Content="Открыть" Padding="10,2" FontSize="12" Click="FileOpen_Click" />
                                                            <Button Content="Сохранить как…" Padding="10,2" FontSize="12" Click="FileSave_Click" />
                                                            <Button Content="Показать в папке" Padding="10,2" FontSize="12"
                                                                    Click="FileShowInFolder_Click" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- Текст выделяется, ссылки в нём кликабельны -->
                                            <local:LinkTextBlock Classes="message" LinkedText="{Binding Text}" IsVisible="{Binding HasText}" />
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}" FontSize="10" Margin="10,0,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </DockPanel>
                                            <Button Content="Отменить отправку" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Padding="8,1" FontSize="11" Click="CancelMessage_Click"
                                                    IsVisible="{Binding CanCancel}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="MessagesHintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="340" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                           Foreground="{StaticResource MutedTextBrush}" />

                <!-- Подсказка при перетаскивании файлов в окно -->
                <Border x:Name="DropOverlay" Margin="12" CornerRadius="12" Background="#E6EFF6FF"
                        BorderBrush="#2563EB" BorderThickness="2" IsHitTestVisible="False" IsVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="📎" FontSize="40" HorizontalAlignment="Center" />
                        <TextBlock Text="Отпустите, чтобы прикрепить файлы" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1E3A8A" />
                    </StackPanel>
                </Border>
            </Panel>
        </DockPanel>
    </Grid>
</Window>
