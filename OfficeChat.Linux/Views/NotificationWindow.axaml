<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OfficeChat.Views"
        x:Class="OfficeChat.Views.NotificationWindow"
        Title="OfficeChat — новое сообщение"
        Width="420" SizeToContent="Height"
        SystemDecorations="None" CanResize="False" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        Background="White">
    <Window.Resources>
        <local:ImageThumbnailConverter x:Key="Thumbnail" DecodeWidth="480" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.bubble.outgoing">
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#2563EB" BorderThickness="2">
        <StackPanel>
            <!-- Яркая шапка: аватар, имя, время, закрыть -->
            <Border Background="{StaticResource HeaderBrush}" Padding="14,10,8,10" Cursor="Hand"
                    PointerReleased="Open_Click" ToolTip.Tip="Открыть переписку">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="White"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarText" FontSize="19" FontWeight="Bold" Foreground="#2563EB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30" Padding="0" FontSize="14"
                            Classes="plain" Foreground="White" VerticalAlignment="Top"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Закрыть" Click="Close_Click" />
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Margin="8,0,6,0" FontSize="12"
                               VerticalAlignment="Center" Foreground="#DBEAFE" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SenderText" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="новое сообщение" FontSize="11" Foreground="#DBEAFE" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Лента: непросмотренные сообщения от этого человека и ваши ответы -->
            <ScrollViewer x:Name="MessagesScroll" Margin="12,10,12,0" MaxHeight="300" Cursor="Hand"
                          PointerReleased="Open_Click" ToolTip.Tip="Открыть переписку">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="bubble" Classes.outgoing="{Binding IsOutgoing}"
                                    Margin="0,3" Padding="10,6,10,5" CornerRadius="8" MaxWidth="360">
                                <StackPanel>
                                    <TextBlock Text="сообщение всем" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               IsVisible="{Binding IsBroadcast}" />
                                    <Image Source="{Binding ImagePath, Converter={StaticResource Thumbnail}}"
                                           MaxWidth="320" MaxHeight="180" Stretch="Uniform" StretchDirection="DownOnly"
                                           HorizontalAlignment="Left" Margin="0,2,0,4" IsVisible="{Binding IsImage}" />
                                    <TextBlock Text="{Binding PreviewText}" FontSize="15" TextWrapping="Wrap" Foreground="#111827" />
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="10" Margin="8,0,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Быстрый ответ -->
            <DockPanel Margin="14,12,14,14">
                <Button DockPanel.Dock="Right" Content="Ответить" Margin="8,0,0,0" Padding="16,6"
                        FontSize="14" FontWeight="SemiBold" Classes="flat" Click="Reply_Click" />
                <TextBox x:Name="ReplyBox" FontSize="14" MaxLength="4000" Watermark="Быстрый ответ…" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
