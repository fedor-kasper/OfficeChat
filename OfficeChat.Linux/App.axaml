<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OfficeChat.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FDE" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#F3F5F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="OnlineBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E5EA" />
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#2563EB" Offset="0" />
            <GradientStop Color="#3B82F6" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Плоская цветная кнопка: <Button Classes="flat" Background="…" /> -->
        <Style Selector="Button.flat">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <!-- Тонкая кнопка без фона (заголовки, ✕) -->
        <Style Selector="Button.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Styles>
</Application>
